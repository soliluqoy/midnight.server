{
	"name": "midnight.server",
	"version": "0.3.0",
	"description": "Midnight panels for pi and native project tools for Claude Code and Codex CLI",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package"
	],
	"files": [
		"src",
		"skills",
		"claude-mod",
		".claude-plugin",
		"plugin.json",
		"mcp.json",
		".agents/plugins/marketplace.json",
		".mcp.json",
		"docs/clients.md",
		"docs/sidebars.md",
		"docs/images/midnight-preview.jpg",
		"README.md",
		"NOTICE",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"test:claude": "node scripts/test-claude-mod.mjs",
		"check": "biome check --error-on-warnings . && tsc --noEmit",
		"test": "node --experimental-strip-types --test tests/*.test.ts"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "1.0.4",
		"@earendil-works/pi-tui": "1.0.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"typescript": "7.0.2"
	}
}
