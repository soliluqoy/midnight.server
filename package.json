{
	"name": "midnight.server",
	"version": "0.1.0",
	"description": "Fast session sidebar and file explorer extracted from midnight.server for pi",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package"
	],
	"files": [
		"src",
		"README.md",
		"NOTICE",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"check": "biome check --error-on-warnings . && tsc --noEmit",
		"test": "node --experimental-strip-types --test tests/*.test.ts"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "1.0.4",
		"@earendil-works/pi-tui": "1.0.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"typescript": "7.0.2"
	}
}
