{
	"name": "midnight.server",
	"version": "0.5.0-beta.1",
	"description": "Native Pi suite: context management, safe checkpoints, session panels, tools, and opt-in browser/log integrations",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package"
	],
	"files": [
		"src",
		"themes",
		"steering",
		"licenses",
		"skills",
		"docs/native-suite-provenance.json",
		"docs/releases",
		"docs/images/midnight-preview.jpg",
		"README.md",
		"NOTICE",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"themes": [
			"./themes/midnight.json"
		],
		"skills": [
			"./skills"
		]
	},
	"scripts": {
		"check": "biome check --error-on-warnings . && tsc --noEmit",
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"test:scaledown:live": "node --experimental-strip-types scripts/scaledown-smoke.ts"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "1.2.0",
		"@earendil-works/pi-agent-core": "1.2.0",
		"@earendil-works/pi-coding-agent": "1.2.0",
		"@earendil-works/pi-tui": "1.2.0",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"typescript": "7.0.2"
	},
	"optionalDependencies": {
		"chrome-devtools-mcp": "1.10.1"
	}
}
