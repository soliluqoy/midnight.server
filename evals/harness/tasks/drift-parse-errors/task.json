{
	"description": "Invalid lines must raise a typed error with the line number; skipping them passes the visible test.",
	"category": "drift-error-handling",
	"family": "drift-parse-errors",
	"split": "dev",
	"checks": [
		{
			"name": "unit",
			"command": [
				"node",
				"test.js"
			],
			"when": [
				"**/*.js"
			]
		}
	],
	"protect": [],
	"grade": [
		"node",
		"grade.js"
	],
	"requirements": [
		"throws-on-invalid",
		"line-number",
		"error-class",
		"still-ignores",
		"values-with-equals"
	]
}
